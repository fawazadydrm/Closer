# ── CLOSER environment variables ──────────────────────────────
# Copy this file to `.env.local` and fill in real values, then
# restart `npm run dev`.

# ── Supabase (REQUIRED for real data) ─────────────────────────
# Without these the app runs on local dummy data (dev mode).
# Get both from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ── Telegram Bot (used by /api/send-reminder) ────────────────
# Optional. If unset, the API returns a "dry-run" preview instead
# of failing. Create a bot via @BotFather, then get your numeric
# chat id by messaging @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
